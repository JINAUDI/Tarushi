<section class="tarushi-section tarushi-rich-text"><div class="tarushi-section__heading">{% if section.settings.eyebrow != blank %}<p class="tarushi-kicker">{{ section.settings.eyebrow }}</p>{% endif %}<h2>{{ section.settings.heading }}</h2></div><div class="rte">{{ section.settings.text }}</div>{% if section.settings.button_label != blank %}<a class="tarushi-button" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>{% endif %}</section>
{% schema %}{"name":"Rich text","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow"},{"type":"text","id":"heading","label":"Heading","default":"Grace, earned."},{"type":"richtext","id":"text","label":"Text","default":"<p>Everyday jewellery for the woman who shines, conquers and stands apart.</p>"},{"type":"text","id":"button_label","label":"Button label"},{"type":"url","id":"button_link","label":"Button link"}],"presets":[{"name":"Rich text"}]}{% endschema %}