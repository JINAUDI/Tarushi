<section class="tarushi-section"><div class="tarushi-section__heading"><p class="tarushi-kicker">The Tarushi edit</p><h1>{{ collection.title }}</h1></div><div class="tarushi-products">{% for product in collection.products %}<article class="tarushi-product-card"><a href="{{ product.url }}"><div class="tarushi-product-card__image">{{ product.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', alt: product.title }}</div><h3>{{ product.title }}</h3><p>{{ product.price | money }}</p></a></article>{% endfor %}</div></section>
