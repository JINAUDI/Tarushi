<section class="tarushi-hero" style="--hero-image:{% if section.settings.image != blank %}url('{{ section.settings.image | image_url: width: 2400 }}'){% else %}url('{{ 'tarushi-jewellery-hero.png' | asset_url }}'){% endif %};--mobile-hero-image:{% if section.settings.mobile_image != blank %}url('{{ section.settings.mobile_image | image_url: width: 1400 }}'){% else %}url('{{ 'mobile-hero-background.png' | asset_url }}'){% endif %};">
  <div class="tarushi-hero__overlay"></div><div class="tarushi-hero__content">
    {% if section.settings.eyebrow != blank %}<p class="tarushi-kicker">{{ section.settings.eyebrow }}</p>{% endif %}<h1>{{ section.settings.heading | newline_to_br }}</h1>{% if section.settings.text != blank %}<p>{{ section.settings.text }}</p>{% endif %}{% if section.settings.button_label != blank %}<a class="tarushi-button" href="{{ section.settings.button_link | default: routes.collections_url }}">{{ section.settings.button_label }}</a>{% endif %}
  </div>
</section>
{% schema %}{"name":"Tarushi hero","settings":[{"type":"image_picker","id":"image","label":"Desktop image"},{"type":"image_picker","id":"mobile_image","label":"Mobile image"},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Everyday gold. Timeless victory."},{"type":"textarea","id":"heading","label":"Heading","default":"She shines.\nShe conquers."},{"type":"textarea","id":"text","label":"Description","default":"Jewellery for the woman who has already arrived."},{"type":"text","id":"button_label","label":"Button label","default":"Discover the collection"},{"type":"url","id":"button_link","label":"Button link"}],"presets":[{"name":"Tarushi hero"}]}{% endschema %}