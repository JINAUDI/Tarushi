<section id="site-imported-hero" class="site-imported-hero" style="--hero-image:{% if section.settings.image != blank %}url('{{ section.settings.image | image_url: width: 2400 }}'){% else %}url('{{ 'tarushi-jewellery-hero.png' | asset_url }}'){% endif %};--mobile-hero-image:{% if section.settings.mobile_image != blank %}url('{{ section.settings.mobile_image | image_url: width: 1400 }}'){% else %}url('{{ 'mobile-hero-background.png' | asset_url }}'){% endif %}">
  <div class="site-imported-hero__background"></div><div class="site-imported-hero__shade"></div>
  <div class="site-imported-hero__top"><span>{{ section.settings.top_left }}</span><span class="site-imported-hero__counter">01 / 05</span></div>
  <button class="site-imported-hero__arrow site-imported-hero__arrow--left" type="button" aria-label="Previous category">←</button>
  <div class="site-imported-hero__content"><span class="site-imported-hero__overline">{{ section.settings.eyebrow }}</span><h1>{{ section.settings.heading_line_one }}<br><em>{{ section.settings.heading_line_two }}</em></h1><p>{{ section.settings.description }}</p>{% if section.settings.button_label != blank %}<a class="site-imported-hero__button" href="{{ section.settings.button_link | default: routes.collections_url }}">{{ section.settings.button_label }}</a>{% endif %}</div>
  <button class="site-imported-hero__arrow site-imported-hero__arrow--right" type="button" aria-label="Next category">→</button>
  <div class="site-imported-hero__discovery"><div class="site-imported-hero__cards">
    {% for block in section.blocks %}{% assign fallback_image = 'tarushi-category-panel-' | append: forloop.index0 | append: '.png' %}<button class="site-imported-hero__card{% if forloop.index == 2 %} is-active{% endif %}" type="button" data-hero-index="{{ forloop.index0 }}" {{ block.shopify_attributes }}>{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 500 | image_tag: loading: 'lazy', alt: block.settings.title }}{% else %}<img src="{{ fallback_image | asset_url }}" alt="{{ block.settings.title }}">{% endif %}<span><small>{{ block.settings.eyebrow }}</small><strong>{{ block.settings.title }}</strong></span></button>{% endfor %}
  </div></div><div class="site-imported-hero__bottom"><span>{{ section.settings.bottom_left }}</span><span>{{ section.settings.bottom_right }}</span></div>
</section>
{% schema %}{"name":"Tarushi hero slider","max_blocks":5,"settings":[{"type":"image_picker","id":"image","label":"Desktop background"},{"type":"image_picker","id":"mobile_image","label":"Mobile background"},{"type":"text","id":"top_left","label":"Top-left label","default":"Visual discovery"},{"type":"text","id":"eyebrow","label":"Hero eyebrow","default":"The everyday extraordinary"},{"type":"text","id":"heading_line_one","label":"Heading line one","default":"She shines."},{"type":"text","id":"heading_line_two","label":"Heading line two","default":"She conquers."},{"type":"textarea","id":"description","label":"Hero description","default":"Contemporary jewellery for the woman who has already arrived."},{"type":"text","id":"button_label","label":"Button label","default":"Explore the collection"},{"type":"url","id":"button_link","label":"Button link"},{"type":"text","id":"bottom_left","label":"Bottom-left label","default":"© 2026 Tarushi Jewellery · India"},{"type":"text","id":"bottom_right","label":"Bottom-right label","default":"Made with intention"}],"blocks":[{"type":"category","name":"Category card","settings":[{"type":"image_picker","id":"image","label":"Card image"},{"type":"text","id":"eyebrow","label":"Card eyebrow","default":"Fine lines"},{"type":"text","id":"title","label":"Card title","default":"Necklaces"}]}],"presets":[{"name":"Tarushi hero slider","blocks":[{"type":"category","settings":{"title":"Rings","eyebrow":"Quiet strength"}},{"type":"category","settings":{"title":"Earrings","eyebrow":"A little light"}},{"type":"category","settings":{"title":"Necklaces","eyebrow":"Fine lines"}},{"type":"category","settings":{"title":"Bangles","eyebrow":"Every curve"}},{"type":"category","settings":{"title":"Pendants","eyebrow":"Made personal"}}]}]}{% endschema %}