<footer class="tarushi-footer"><div><p class="tarushi-footer__brand">{{ section.settings.brand_name }}</p><p>{{ section.settings.description }}</p></div><div><h2>{{ section.settings.menu_heading }}</h2>{% for link in section.settings.menu.links %}<a href="{{ link.url }}">{{ link.title }}</a>{% endfor %}</div><p class="tarushi-footer__copyright">{{ section.settings.copyright }}</p></footer>
{% schema %}{"name":"Footer","settings":[{"type":"text","id":"brand_name","label":"Brand name","default":"Tarushi Jewellery"},{"type":"textarea","id":"description","label":"Description","default":"Worn by women who’ve already won."},{"type":"text","id":"menu_heading","label":"Menu heading","default":"Explore"},{"type":"link_list","id":"menu","label":"Footer menu","default":"footer"},{"type":"text","id":"copyright","label":"Copyright text","default":"© 2026 Tarushi Jewellery. All rights reserved."}],"presets":[{"name":"Footer"}]}{% endschema %}