<section class="tarushi-section tarushi-product-page"><div class="tarushi-product-page__media">{{ product.featured_image | image_url: width: 1200 | image_tag: loading: 'eager', alt: product.title }}</div><div class="tarushi-product-page__info"><p class="tarushi-kicker">{{ section.settings.eyebrow }}</p><h1>{{ product.title }}</h1><div class="tarushi-price">{{ product.selected_or_first_available_variant.price | money }}</div><div class="rte">{{ product.description }}</div>{% form 'product', product, class: 'tarushi-product-form' %}{% if product.has_only_default_variant == false %}<label for="Variant">{{ section.settings.variant_label }}</label><select id="Variant" name="id">{% for variant in product.variants %}<option value="{{ variant.id }}"{% if variant == product.selected_or_first_available_variant %} selected{% endif %}{% unless variant.available %} disabled{% endunless %}>{{ variant.title }} – {{ variant.price | money }}</option>{% endfor %}</select>{% else %}<input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">{% endif %}<label for="Quantity">{{ section.settings.quantity_label }}</label><input id="Quantity" name="quantity" type="number" min="1" value="1"><button class="tarushi-button" type="submit">{{ section.settings.button_label }}</button>{% endform %}</div></section>
{% schema %}{"name":"Product","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Tarushi jewellery"},{"type":"text","id":"variant_label","label":"Variant label","default":"Style"},{"type":"text","id":"quantity_label","label":"Quantity label","default":"Quantity"},{"type":"text","id":"button_label","label":"Button label","default":"Add to cart"}],"presets":[{"name":"Product"}]}{% endschema %}