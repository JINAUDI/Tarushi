<section class="tarushi-section tarushi-categories"><div class="tarushi-section__heading"><p class="tarushi-kicker">The Tarushi edit</p><h2>{{ section.settings.heading }}</h2><p>{{ section.settings.description }}</p></div><div class="tarushi-category-grid">{% for block in section.blocks %}{% assign fallback = 'h1-cat-product-image-' | append: forloop.index | append: '.jpg' %}<a class="tarushi-category-card" href="{{ block.settings.link | default: routes.collections_url }}" {{ block.shopify_attributes }}>{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', alt: block.settings.title }}{% else %}<img src="{{ fallback | asset_url }}" loading="lazy" alt="{{ block.settings.title }}">{% endif %}<span><small>{{ block.settings.eyebrow }}</small><strong>{{ block.settings.title }}</strong></span></a>{% endfor %}</div></section>
{% schema %}{"name":"Category showcase","max_blocks":5,"settings":[{"type":"text","id":"heading","label":"Heading","default":"Discover Tarushi"},{"type":"textarea","id":"description","label":"Description","default":"Jewellery for the woman who has already arrived."}],"blocks":[{"type":"category","name":"Category","settings":[{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Fine lines"},{"type":"text","id":"title","label":"Title","default":"Necklaces"},{"type":"url","id":"link","label":"Link"}]}],"presets":[{"name":"Category showcase","blocks":[{"type":"category","settings":{"eyebrow":"Quiet strength","title":"Rings"}},{"type":"category","settings":{"eyebrow":"A little light","title":"Earrings"}},{"type":"category","settings":{"eyebrow":"Fine lines","title":"Necklaces"}},{"type":"category","settings":{"eyebrow":"Every curve","title":"Bangles"}},{"type":"category","settings":{"eyebrow":"Made personal","title":"Pendants"}}]}]}{% endschema %}