<section class="tarushi-section tarushi-cart"><div class="tarushi-section__heading"><p class="tarushi-kicker">Your selection</p><h1>Cart</h1></div>{% if cart.item_count == 0 %}<p>Your cart is waiting for something beautiful.</p>{% else %}{% form 'cart', cart %}{% for item in cart.items %}<div class="tarushi-cart__item"><a href="{{ item.url }}">{{ item.image | image_url: width: 180 | image_tag: alt: item.title }}</a><div><h2>{{ item.product.title }}</h2><p>{{ item.final_line_price | money }}</p><input name="updates[]" value="{{ item.quantity }}" type="number" min="0"></div></div>{% endfor %}<button class="tarushi-button" name="checkout" type="submit">Checkout</button>{% endform %}{% endif %}</section>
