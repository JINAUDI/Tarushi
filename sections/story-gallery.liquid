<section class="tarushi-section tarushi-gallery"><div class="tarushi-section__heading"><p class="tarushi-kicker">{{ section.settings.eyebrow }}</p><h2>{{ section.settings.heading }}</h2></div><div class="tarushi-gallery-grid">{% for block in section.blocks %}{% assign fallback = 'instagram-gallery-img-' | append: forloop.index | append: '.jpg' %}<a href="{{ block.settings.link | default: '#' }}" {{ block.shopify_attributes }}>{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', alt: block.settings.alt }}{% else %}<img src="{{ fallback | asset_url }}" loading="lazy" alt="{{ block.settings.alt }}">{% endif %}</a>{% endfor %}</div></section>
{% schema %}{"name":"Story gallery","max_blocks":8,"settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Instagram"},{"type":"text","id":"heading","label":"Heading","default":"The Tarushi story"}],"blocks":[{"type":"image","name":"Gallery image","settings":[{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"alt","label":"Alt text","default":"Tarushi jewellery"},{"type":"url","id":"link","label":"Link"}]}],"presets":[{"name":"Story gallery","blocks":[{"type":"image"},{"type":"image"},{"type":"image"},{"type":"image"},{"type":"image"},{"type":"image"},{"type":"image"},{"type":"image"}]}]}{% endschema %}